<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#3498DB"
            app:title="用户筛选"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_close_24"
            app:navigationIconTint="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 快速筛选选项 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="快速筛选"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_quick_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="false"
                        app:chipSpacingHorizontal="12dp"
                        app:chipSpacingVertical="4dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_activated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="已激活"
                            android:checkable="true"
                            android:textColor="@color/chip_text_color_activated"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            app:chipBackgroundColor="@color/chip_background_activated"
                            app:chipStrokeColor="#27AE60"
                            app:chipStrokeWidth="2dp"
                            app:checkedIconVisible="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_not_activated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未激活"
                            android:checkable="true"
                            android:textColor="@color/chip_text_color_not_activated"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            app:chipBackgroundColor="@color/chip_background_not_activated"
                            app:chipStrokeColor="#E74C3C"
                            app:chipStrokeWidth="2dp"
                            app:checkedIconVisible="false" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 筛选条件卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 标题 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="条件筛选"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#2C3E50"
                        android:layout_marginBottom="16dp" />

                    <!-- 课题和分组放在一行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- 课题选择 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="课题"
                                android:textSize="12sp"
                                android:textColor="#7F8C8D"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinner_project"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/spinner_background" />
                        </LinearLayout>

                        <!-- 分组选择 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="分组"
                                android:textSize="12sp"
                                android:textColor="#7F8C8D"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinner_team"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/spinner_background" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 姓名和电话放在一行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- 姓名 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="姓名"
                                android:textSize="12sp"
                                android:textColor="#7F8C8D"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/et_username"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="输入姓名"
                                android:inputType="textPersonName"
                                android:maxLength="6"
                                android:textSize="14sp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/spinner_background" />
                        </LinearLayout>

                        <!-- 电话 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="电话"
                                android:textSize="12sp"
                                android:textColor="#7F8C8D"
                                android:layout_marginBottom="4dp" />

                            <EditText
                                android:id="@+id/et_phone"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="输入电话"
                                android:inputType="phone"
                                android:maxLength="11"
                                android:textSize="14sp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/spinner_background" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 性别和激活状态放在一行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <!-- 性别选择 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="性别"
                                android:textSize="12sp"
                                android:textColor="#7F8C8D"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinner_gender"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/spinner_background" />
                        </LinearLayout>

                        <!-- 激活状态选择 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="激活状态"
                                android:textSize="12sp"
                                android:textColor="#7F8C8D"
                                android:layout_marginBottom="4dp" />

                            <Spinner
                                android:id="@+id/spinner_login_status"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/spinner_background" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- 录入日期区间 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="录入日期"
                        android:textSize="12sp"
                        android:textColor="#7F8C8D"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="24dp">

                        <EditText
                            android:id="@+id/et_date_start"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:hint="开始日期"
                            android:focusable="false"
                            android:clickable="true"
                            android:textSize="14sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/spinner_background" />

                        <EditText
                            android:id="@+id/et_date_end"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:hint="结束日期"
                            android:focusable="false"
                            android:clickable="true"
                            android:textSize="14sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/spinner_background" />

                    </LinearLayout>

                    <!-- 按钮组 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- 重置按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:text="重置"
                            android:textSize="16sp"
                            android:textColor="#7F8C8D"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:strokeColor="#7F8C8D"
                            app:cornerRadius="28dp" />

                        <!-- 确认筛选按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_apply"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:text="应用筛选"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            app:backgroundTint="#3498DB"
                            app:cornerRadius="28dp"
                            app:elevation="2dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>