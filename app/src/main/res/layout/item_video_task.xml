<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 系列封面图 -->
        <ImageView
            android:id="@+id/iv_series_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:background="@android:color/darker_gray"
            android:src="@drawable/ic_video_placeholder"
            app:cardCornerRadius="8dp"
            android:contentDescription="@string/content_desc_video_thumbnail" />

        <!-- 系列信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 系列标题 - 大字体适合老年人 -->
            <TextView
                android:id="@+id/tv_series_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rehabilitation_training_series"
                android:textSize="24sp"
                android:textColor="#222"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:gravity="center"
                android:textAlignment="center" />

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#CCCCCC" />

            <!-- 系列描述 - 大字体 -->
            <TextView
                android:id="@+id/tv_series_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_description_placeholder"
                android:textSize="18sp"
                android:textColor="#666"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>