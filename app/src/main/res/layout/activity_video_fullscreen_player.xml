<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/fs_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        app:use_controller="true"
        app:resize_mode="zoom"
        app:show_timeout="5000"
        app:controller_layout_id="@layout/activity_player_control_view" />

    <!-- 退出全屏按钮 - 移到右上角避免遮挡视频内容 -->
    <TextView
        android:id="@+id/btn_exit_fullscreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:minWidth="120dp"
        android:minHeight="60dp"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/bg_text_border"
        android:clickable="true"
        android:focusable="true"
        android:text="退出全屏"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:gravity="center"/>

</FrameLayout>