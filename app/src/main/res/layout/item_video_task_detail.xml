<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 第一行：视频标题 -->
        <TextView
            android:id="@+id/tv_video_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="COPD康复热身"
            android:textSize="26sp"
            android:textColor="#222"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#DDDDDD" />

        <!-- 第二行：视频缩略图和描述 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- 视频缩略图容器 -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="100dp">

                <ImageView
                    android:id="@+id/iv_video_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@android:color/darker_gray"
                    android:contentDescription="视频缩略图" />

                <!-- 播放按钮覆盖层 - 更大 -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_circle"
                    android:alpha="0.9"
                    android:contentDescription="播放按钮" />

                <!-- 时长显示 - 增大字体 -->
                <TextView
                    android:id="@+id/tv_video_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="#80000000"
                    android:padding="8dp"
                    android:text="05:00"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    android:contentDescription="视频时长" />

                <!-- 正在播放指示器 - 移到右上角 -->
                <TextView
                    android:id="@+id/tv_playing_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:text="正在播放"
                    android:textSize="20sp"
                    android:textColor="#FF4444"
                    android:textStyle="bold"
                    android:background="#FFEEEE"
                    android:padding="4dp"
                    android:visibility="gone" />

                <!-- 播放状态指示条 - 底部 -->
                <View
                    android:id="@+id/view_playing_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom"
                    android:background="#FF4444"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- 视频描述 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_video_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="热身运动"
                    android:textSize="22sp"
                    android:textColor="#666"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>